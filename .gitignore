# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# Build output
build/
dist/
*.apworld
*.zip

# C++ / MSVC build artifacts
mod/asi/plugin/bin/
mod/asi/plugin/obj/
*.vcxproj.user
*.obj
*.asi

# Compiled mod payloads (built from source, bundled into the .apworld). Every
# CLEO script is compiled from a .txt the build writes, so the pattern covers
# the ones add_markers.py carries out of the MAIN section too.
mod/scm/main.scm
mod/cleo/*.cs

# The player's own stock script, which the build reads to compute the deltas it
# ships. It is the game's file, so it is never committed and never packaged: what
# ships is the difference from it.
mod/scm/stock.scm

# The payload staged into the world package for the length of one build.
# The build clears it again; an interrupted one leaves it behind.
apworld/gta_vice_city/data/mod/

# The decision log and research, local to this machine
notes/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
